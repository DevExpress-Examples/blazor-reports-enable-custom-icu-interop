<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorIcuDataFileName>Native/icudt_custom.dat</BlazorIcuDataFileName>
    <WasmBuildNative>true</WasmBuildNative>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmNativeStrip>false</WasmNativeStrip>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Blazor.Reporting.JSBasedControls.WebAssembly" Version="26.1.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.15" />
    <PackageReference Include="DevExpress.Blazor" Version="26.1.6" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.6" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.1" />
    <PackageReference Include="DevExpress.Blazor.Reporting.Viewer" Version="26.1.6" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.15" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.Views.Blazor" Version="3.119.1" />
    <NativeFileReference Include="$(HarfBuzzSharpStaticLibraryPath)\3.1.19\st\*.a" />
    <NativeFileReference Include="Native\wrapper.c" />
  </ItemGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="Layout\MainLayout.razor" />
  </ItemGroup>
</Project>